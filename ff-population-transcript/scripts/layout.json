   {"key": "dds_abiv", "value": "3%", "label": "ABI value", "block": "Dread disease: standard"}
  ],
  "dd_cover": {"value": "R 500 000.00", "keys": ["dd_cover", "dds_cover"]},
  "forbidden_labels": {"Permanent disability: fractured cover": ["Life Cover (WOL) ABI"]},
  "not_set_by_rule": ["lc_abiv", "pd_abiv", "ip_abiv", "ips_abiv"]
