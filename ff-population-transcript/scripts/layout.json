   {"key": "lc_ccabi", "value": "5%", "label": "Childcare ABI", "block": "Life cover: fractured cover"},
   {"key": "pd_hhabi", "value": "5%", "label": "Household needs ABI", "block": "Permanent disability: fractured cover", "added": true},
