  {
   "id": "duties_total",
   "target": "d_tot",
   "op": "sum",
   "terms": ["d_desk", "d_supo", "d_trav", "d_sups", "d_light", "d_mod", "d_heavy"],
   "kind": "pct",
   "assumed": false
  },
  {
   "id": "disposable",
   "target": "disp",
   "op": "diff",
   "terms": ["net", "exp"],
   "kind": "money",
   "assumed": true,
   "means": "disposable income = take-home net income minus monthly expenses"
  },
  {
   "id": "lc_cc",
   "target": "lc_cc",
   "op": "equals",
   "terms": ["@kids_total"],
   "kind": "money",
   "assumed": true,
   "means": "childcare in the risk calculation = total monthly childcare of all children"
  },
  {
   "id": "lc_dr",
   "target": "lc_dr",
   "op": "equals",
   "terms": ["@debts_monthly"],
   "kind": "money",
   "assumed": true,
   "never_exclude_debt": true,
   "means": "debt repayments in the risk calculation = monthly repayments of ALL debts (debt is never left out because of credit life)"
  },
  {
   "id": "lc_hh",
   "target": "lc_hh",
   "op": "diff",
   "terms": ["net", "lc_cc", "lc_dr"],
   "kind": "money",
   "assumed": true,
   "means": "total household income needed = take-home net income minus childcare minus debt repayments"
  }
 ],
